# tw-ai-toolkit — Environment variables template
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.
#
# ─────────────────────────────────────────────
# INSTALLATION (run once per consumer repo)
# ─────────────────────────────────────────────
#
#   Step 1 — clone the toolkit once (anywhere on your machine)
#   git clone https://github.com/tweladera/tw-ai-toolkit.git ~/tw-ai-toolkit
#
#   Step 2 — run from your project root
#   python3 ~/tw-ai-toolkit/scripts/install.py --local ~/tw-ai-toolkit
#   python3 .ai/toolkit/scripts/install.py --link-all
#   python3 .ai/toolkit/scripts/install.py --verify
#
# UPDATE (pull latest toolkit + re-link new skills)
#
#   cd ~/tw-ai-toolkit && git pull origin main
#   cd /path/to/your-repo && python3 .ai/toolkit/scripts/install.py --link-all
#
# Or from this repo using make:
#
#   make install TOOLKIT=~/tw-ai-toolkit TARGET=/path/to/your-repo
#   make update  TOOLKIT=~/tw-ai-toolkit TARGET=/path/to/your-repo
#
# ─────────────────────────────────────────────
# MCP SERVER CREDENTIALS
# ─────────────────────────────────────────────
# Configure only the integrations your client uses.
# See mcp/<server>/server.md for full setup instructions.

# GitHub (tw-github MCP)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# GitLab (tw-gitlab MCP) — cloud or self-hosted
GITLAB_TOKEN=glpat_your_gitlab_personal_access_token
GITLAB_BASE_URL=https://gitlab.com
GITLAB_DEFAULT_PROJECT=group/project

# Jira (tw-jira MCP)
JIRA_TOKEN=your_jira_api_token
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com

# Confluence (tw-confluence MCP)
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token

# SonarQube / SonarCloud (tw-sonarqube MCP)
SONAR_TOKEN=sqp_your_sonarqube_token
SONAR_BASE_URL=https://sonarcloud.io
SONAR_DEFAULT_PROJECT=your_project_key
# SONAR_ORGANIZATION=your_org   # SonarCloud only

# Azure DevOps (tw-azure-devops MCP)
ADO_TOKEN=your_azure_devops_personal_access_token
ADO_ORGANIZATION=https://dev.azure.com/your-org
ADO_PROJECT=your-project
